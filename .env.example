# ===== サーバー専用 =====

# アプリ実行時の接続（Supabase プーラー / Transaction mode / port 6543）
# 例: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# マイグレーション用の直接接続（port 5432）
# 例: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# LINE Login チャネルID
LINE_CHANNEL_ID=

# seed で登録する家族の LINE ユーザーID（カンマ区切り）
SEED_LINE_USER_IDS=


# Vercel Cron（/api/cron/keepalive）の認証用。Authorization: Bearer <値> と照合する。
CRON_SECRET=


# ===== クライアントに公開してよい値 =====

# LIFF アプリID
NEXT_PUBLIC_LIFF_ID=
